# ─── Servidor de Sinalização ─────────────────────────────────────────────────
PORT=3001
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# ─── Servidor TURN (para ambientes com NAT restritivo) ────────────────────────
# Gere credenciais em: https://www.metered.ca/tools/openrelay/
TURN_URL=turn:openrelay.metered.ca:80
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject

# ─── Cliente ─────────────────────────────────────────────────────────────────
VITE_SERVER_URL=http://127.0.0.1:3001
VITE_TURN_URL=turn:openrelay.metered.ca:80
VITE_TURN_USER=openrelayproject
VITE_TURN_CREDENTIAL=openrelayproject
