# ─── Servidor de Sinalização ─────────────────────────────────────────────────
PORT=3001
CLIENT_ORIGIN=http://localhost:3000
# URL pública (opcional). Preenchida automaticamente pelo script `npm run share`
# (túnel Cloudflare). Usada nos links de convite e na allowlist de CORS.
# PUBLIC_URL=https://xxxx.trycloudflare.com
# Endereço de escuta. Padrão 127.0.0.1 (só local). Em hospedagem como o Render, use 0.0.0.0.
# HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Opcionais: pasta de logs e pasta do cliente compilado servida pelo servidor
# LOG_DIR=./logs
# CLIENT_DIST_DIR=../client/dist

# ─── Cliente ─────────────────────────────────────────────────────────────────
VITE_SERVER_URL=http://127.0.0.1:3001

# ─── TURN (NAT restritivo) ───────────────────────────────────────────────────
# As credenciais TURN são geradas pelo SERVIDOR (efêmeras) e NÃO vão no bundle do cliente
# (as antigas VITE_TURN_* foram removidas). Escolha UM modo:
# a) coturn próprio (segredo HMAC compartilhado, use-auth-secret):
# TURN_URLS=turn:turn.exemplo.com:3478,turns:turn.exemplo.com:5349
# TURN_SECRET=troque-por-um-segredo-longo-e-aleatorio
# b) Cloudflare Realtime TURN:
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Sem TURN configurado só o STUN público é usado e o Modo privacidade é ignorado.

# ─── Limites do servidor ─────────────────────────────────────────────────────
# Espectadores por sala (padrão 8)
# MAX_VIEWERS_PER_ROOM=8
# Salas simultâneas (padrão 200)
# MAX_ROOMS=200
# Conexões simultâneas totais (padrão 500)
# MAX_CONNECTIONS=500
# Conexões simultâneas por IP (padrão 20)
# MAX_CONNECTIONS_PER_IP=20
# Duração máxima de uma sala, em horas (padrão 12)
# ROOM_MAX_HOURS=12
# Saltos de proxy confiáveis para obter o IP real (Render/Nginx = 1; direto = 0)
# TRUST_PROXY=1

# ─── Atualização do app desktop (opcional) ───────────────────────────────────
# Só vale em build local/dev. No app empacotado, a variável de ambiente é IGNORADA: o feed só
# é aceito se embutido no build (KIARA_UPDATE_URL na hora do `npm run build-info`). Somente https.
# Feed https "generic" com latest.yml + KIARA-Setup-x.y.z.exe + .blockmap (local PÚBLICO).
# Necessário se o repositório do GitHub for privado. Sem isso, o app usa as Releases do repo.
# KIARA_UPDATE_URL=https://exemplo.com/kiara-releases/
